# Ask for required student details and remove extra spaces using .strip()
first_name = input("Enter first name: ").strip()
last_name = input("Enter last name: ").strip()
section = input("Enter section: ").strip()
subject = input("Enter favorite subject: ").strip()

# Combine and format strings using .title() and .upper()
full_name = f"{first_name} {last_name}".title()
name_code = full_name.upper()
formatted_section = section.upper()
formatted_subject = subject.title()

# Display the cleaned and formatted output
print("\nFormatted Output:")
print("Name:", full_name)
print("Name Code:", name_code)
print("Section:", formatted_section)
print("Favorite Subject:", formatted_subject)
print("Character Count:", len(full_name))
